{
  "name": "@chenyican/vue-fabric-editor",
  "version": "1.0.4",
  "private": false,
  "description": "基于 Vue2.6 + Fabric.js 的图片设计编辑器（移植自 ikuaitu/vue-fabric-editor）",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhiqinyigu/vue-fabric-editor.git"
  },
  "homepage": "https://github.com/zhiqinyigu/vue-fabric-editor#readme",
  "bugs": {
    "url": "https://github.com/zhiqinyigu/vue-fabric-editor/issues"
  },
  "main": "dist/vue-fabric-editor/vue-fabric-editor.common.js",
  "module": "dist/vue-fabric-editor/vue-fabric-editor.common.js",
  "types": "types/index.d.ts",
  "style": "dist/vue-fabric-editor/vue-fabric-editor.css",
  "unpkg": "dist/vue-fabric-editor/vue-fabric-editor.umd.min.js",
  "jsdelivr": "dist/vue-fabric-editor/vue-fabric-editor.umd.min.js",
  "files": [
    "dist/vue-fabric-editor",
    "dist/fabric-renderer",
    "types",
    "fabric-renderer.js"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "**/*.vue",
    "**/renderPatches.js",
    "**/objects/*.js"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/vue-fabric-editor/vue-fabric-editor.common.js",
      "require": "./dist/vue-fabric-editor/vue-fabric-editor.common.js",
      "default": "./dist/vue-fabric-editor/vue-fabric-editor.common.js"
    },
    "./style": "./dist/vue-fabric-editor/vue-fabric-editor.css",
    "./fabric-renderer": {
      "types": "./types/fabric-renderer.d.ts",
      "import": "./dist/fabric-renderer/fabric-renderer.common.js",
      "require": "./dist/fabric-renderer/fabric-renderer.common.js",
      "default": "./dist/fabric-renderer/fabric-renderer.common.js"
    },
    "./fabric-renderer/style": "./dist/fabric-renderer/fabric-renderer.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "fabric-renderer": [
        "types/fabric-renderer.d.ts"
      ]
    }
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:staging": "vue-cli-service build --mode staging",
    "build:prod": "vue-cli-service build --mode production",
    "build:lib": "vue-cli-service build --target lib --name vue-fabric-editor --dest dist/vue-fabric-editor src/lib/index.js",
    "build:lib:renderer": "vue-cli-service build --target lib --name fabric-renderer --dest dist/fabric-renderer src/lib/renderer.js",
    "prepublishOnly": "npm run build:lib && npm run build:lib:renderer",
    "lint": "vue-cli-service lint",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.types.json",
    "test:layer": "node test-layer.js"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "colord": "^2.10.0",
    "svg-path-editor-lib": "^1.0.4",
    "vue-router": "^3.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~4.4.4",
    "@vue/cli-plugin-eslint": "~4.4.4",
    "@vue/cli-service": "~4.4.4",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.0.6",
    "dayjs": "^1.11.11",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^8.0.3",
    "jest": "^27.0.5",
    "jest-environment-jsdom": "^27.0.6",
    "jsdom": "^19.0.0",
    "less": "^4.1.3",
    "less-loader": "^7.3.0",
    "prettier": "2.8.4",
    "qs": "^6.12.1",
    "raw-loader": "^4.0.2",
    "typescript": "^5.1.6",
    "vue-lazyload": "^1.3.4",
    "vue-masonry": "^0.11.3",
    "vue-svg-loader": "^0.16.0",
    "vue-template-compiler": "2.6.10"
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.7.2",
    "@webtoon/psd": "^0.4.0",
    "events": "^3.3.0",
    "fabric": "~5.5.0",
    "fontfaceobserver": "^2.1.0",
    "hotkeys-js": "^3.8.8",
    "jsbarcode": "^3.11.6",
    "lodash-es": "^4.17.21",
    "number-precision": "^1.6.0",
    "qr-code-styling": "^1.9.2",
    "tapable": "^2.2.1",
    "uuid": "^8.3.2",
    "view-design": "^4.7.0",
    "vue": "^2.6.10",
    "vue-cropper": "^0.5.10",
    "vue-i18n": "^8.28.2"
  }
}
